# development | production
APP_ENV=development
PORT=8080

# Postgres (Neon or local). Required.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# HS256 signing key, >= 32 chars in production (dev uses a built-in key if empty).
JWT_SECRET=

# Comma-separated admin dashboard origins (required in production).
CORS_ORIGINS=http://localhost:5173

# Student sign-in. Leave empty to disable that provider.
GOOGLE_CLIENT_IDS=
TELEGRAM_LOGIN_BOT_TOKEN=

# Media: Cloudinary if set, otherwise files are stored in UPLOAD_DIR and served at /uploads.
CLOUDINARY_URL=
UPLOAD_DIR=uploads
PUBLIC_BASE_URL=http://localhost:8080

# First owner admin, created on startup only if no admin exists yet.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# Password reset codes are emailed when SMTP_HOST and SMTP_FROM are set.
# Otherwise (and for phone logins) an admin issues the code from the student page.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
