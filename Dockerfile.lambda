# Victory API on AWS Lambda: the same server, run through the AWS Lambda Web
# Adapter (it turns Lambda invocations into HTTP requests on port 8080).
FROM golang:1.26-alpine AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build -trimpath -ldflags="-s -w" -o /out/api ./cmd/api

FROM alpine:3.22
RUN apk add --no-cache ca-certificates tzdata
COPY --from=public.ecr.aws/awsguru/aws-lambda-adapter:0.9.1 /lambda-adapter /opt/extensions/lambda-adapter
COPY --from=build /out/api /usr/local/bin/api
# Lambda's disk is read-only except /tmp. Production should set CLOUDINARY_URL;
# without it uploads go to /tmp and are lost when the function restarts.
ENV APP_ENV=production PORT=8080 UPLOAD_DIR=/tmp/uploads \
    AWS_LWA_PORT=8080 AWS_LWA_READINESS_CHECK_PATH=/healthz
WORKDIR /tmp
ENTRYPOINT ["/usr/local/bin/api"]
